# ─── Database ───────────────────────────────────────────────
POSTGRES_DB=mycfo
POSTGRES_USER=mycfo
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_20

# ─── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_use_openssl_rand_base64_16

# ─── Security ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_16

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── App ────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Optional: Ollama AI ────────────────────────────────────
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2

# ─── Optional: SMTP Notifications ───────────────────────────
# SMTP_HOST=your-smtp-host.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=mycfo@yourdomain.com

# ─── Optional: WhatsApp (Twilio) ────────────────────────────
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
